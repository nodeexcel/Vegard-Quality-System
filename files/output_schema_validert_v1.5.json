{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://validert.no/schemas/output_schema_validert_v1.7.json",
  "title": "VALIDERT Public Output Schema v1.7",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "meta",
    "gate",
    "disclaimers"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "generated_at",
        "language",
        "analysis_complete"
      ],
      "properties": {
        "schema_version": {
          "type": "string",
          "description": "Skjemaversjon."
        },
        "generated_at": {
          "type": "string",
          "format": "date-time"
        },
        "language": {
          "type": "string",
          "description": "Språkkode, f.eks. nb-NO."
        },
        "analysis_complete": {
          "type": "boolean",
          "description": "True hvis analysen er komplett og score er beregnet. False ved INCOMPLETE."
        },
        "status": {
          "type": "string",
          "enum": [
            "OK",
            "INCOMPLETE",
            "ERROR"
          ],
          "description": "Status for analysen."
        },
        "status_message": {
          "type": "string",
          "description": "Forklaring ved INCOMPLETE/ERROR."
        },
        "report_id": {
          "type": "string"
        },
        "document_hash": {
          "type": "string"
        }
      }
    },
    "trygghetsscore": {
      "anyOf": [
        {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        {
          "type": "null"
        }
      ],
      "description": "Totalscore (0-100). Kan være null/utelatt ved INCOMPLETE avhengig av policy."
    },
    "score_band": {
      "type": "string",
      "enum": [
        "Lav",
        "Middels",
        "Høy",
        "Ukjent"
      ],
      "description": "Sjablong for totalscore."
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "blocked_96",
        "max_score_if_blocked"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "blocked_96": {
          "type": "boolean"
        },
        "max_score_if_blocked": {
          "anyOf": [
            {
              "type": "integer",
              "enum": [95]
            },
            {
              "type": "null"
            }
          ],
          "description": "Typisk 95 dersom 96-gate blokkeres, ellers null."
        },
        "blocked_by_count": {
          "type": "integer",
          "minimum": 0
        },
        "message": {
          "type": "string",
          "description": "Kort forklaring for bruker."
        }
      }
    },
    "top_issues": {
      "type": "array",
      "description": "Top 3–5 viktigste avvik for bruker (prioritert).",
      "items": {
        "$ref": "#/$defs/user_issue"
      }
    },
    "all_findings": {
      "type": "array",
      "description": "Full liste med alle funn (skal leveres i første kjøring).",
      "items": {
        "$ref": "#/$defs/user_finding"
      }
    },
    "how_to_improve": {
      "type": "array",
      "description": "Konkret liste med hva som kan endres for å forbedre score.",
      "items": {
        "$ref": "#/$defs/user_improvement"
      }
    },
    "category_breakdown": {
      "type": "array",
      "description": "Nedbryting per kategori (A–F).",
      "items": {
        "$ref": "#/$defs/category_breakdown"
      }
    },
    "disclaimers": {
      "type": "array",
      "description": "Ansvarsfraskrivelser som alltid skal vises.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "gate_effect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blocks_96_gate": {
          "type": "boolean"
        },
        "caps_total_score_to": {
          "anyOf": [
            {
              "type": "integer",
              "enum": [95]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "user_issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "title",
        "severity",
        "deduction_band",
        "message"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "minor",
            "major"
          ]
        },
        "deduction_band": {
          "type": "string",
          "enum": [
            "Lavt trekk",
            "Middels trekk",
            "Høyt trekk",
            "Ikke scoretrekk"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "recommended_fix_text": {
          "type": "string"
        },
        "rewrite_strategy": {
          "type": "string",
          "description": "Intern strategi for hvordan eksempeltekst er bygget."
        },
        "suggested_rewrite_text": {
          "type": "string",
          "description": "Kort, nøktern og punktspesifikk eksempeltekst som kan brukes som utgangspunkt for copy/paste."
        },
        "gate_effect": {
          "$ref": "#/$defs/gate_effect"
        }
      }
    },
    "user_finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "finding_id",
        "category",
        "severity",
        "title",
        "message",
        "deduction_band"
      ],
      "properties": {
        "finding_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "minor",
            "major"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "deduction_band": {
          "type": "string",
          "enum": [
            "Lavt trekk",
            "Middels trekk",
            "Høyt trekk",
            "Ikke scoretrekk"
          ]
        },
        "recommended_fix_text": {
          "type": "string"
        },
        "rewrite_strategy": {
          "type": "string",
          "description": "Intern strategi for hvordan eksempeltekst er bygget."
        },
        "suggested_rewrite_text": {
          "type": "string",
          "description": "Kort, nøktern og punktspesifikk eksempeltekst som kan brukes som utgangspunkt for copy/paste."
        },
        "evidence_snippets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gate_effect": {
          "$ref": "#/$defs/gate_effect"
        }
      }
    },
    "user_improvement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "title",
        "recommended_fix_text"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "recommended_fix_text": {
          "type": "string",
          "minLength": 1
        },
        "rewrite_strategy": {
          "type": "string",
          "description": "Intern strategi for hvordan eksempeltekst er bygget."
        },
        "suggested_rewrite_text": {
          "type": "string",
          "description": "Kort, nøktern og punktspesifikk eksempeltekst som kan brukes som utgangspunkt for copy/paste."
        }
      }
    },
    "category_breakdown": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "deduction_band",
        "summary"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "deduction_band": {
          "type": "string",
          "enum": [
            "Lavt trekk",
            "Middels trekk",
            "Høyt trekk",
            "Ikke scoretrekk"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "meta": {
            "properties": {
              "analysis_complete": {
                "const": true
              }
            },
            "required": [
              "analysis_complete"
            ]
          }
        },
        "required": [
          "meta"
        ]
      },
      "then": {
        "required": [
          "meta",
          "gate",
          "disclaimers",
          "trygghetsscore",
          "score_band",
          "top_issues",
          "all_findings"
        ]
      },
      "else": {
        "required": [
          "meta",
          "gate",
          "disclaimers"
        ],
        "properties": {
          "score_band": {
            "type": "string",
            "enum": [
              "Ukjent"
            ],
            "description": "Ved INCOMPLETE settes score_band til 'Ukjent' dersom feltet er inkludert."
          }
        }
      }
    }
  ]
}