{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://validert.no/schemas/validert_feedback_v1.5.1.schema.json",
  "title": "VALIDERT Feedback Schema v1.5",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "analysis_complete",
    "report_id",
    "document_hash",
    "ordering",
    "gate"
  ],
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "analysis_complete": {
      "type": "boolean"
    },
    "report_id": {
      "type": "string",
      "minLength": 1
    },
    "document_hash": {
      "type": "string",
      "minLength": 1
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "arkat_order",
        "category_order"
      ],
      "properties": {
        "arkat_order": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "arsak",
              "risiko",
              "konsekvens",
              "anbefalt_tiltak"
            ]
          },
          "minItems": 4,
          "maxItems": 4
        },
        "category_order": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "score": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "total",
            "category_deductions"
          ],
          "properties": {
            "total": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Totalscore (0-100). Null eller utelatt når analysis_complete=false (INCOMPLETE)."
            },
            "category_deductions": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "category",
                  "deduction",
                  "max_deduction"
                ],
                "properties": {
                  "category": {
                    "type": "string",
                    "minLength": 1
                  },
                  "deduction": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max_deduction": {
                    "type": "number",
                    "minimum": 0
                  }
                }
              }
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "active",
        "blocked_96",
        "max_score_if_blocked"
      ],
      "properties": {
        "active": {
          "type": "boolean"
        },
        "blocked_96": {
          "type": "boolean"
        },
        "max_score_if_blocked": {
          "anyOf": [
            {
              "type": "integer",
              "enum": [
                95
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "blocked_by": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        }
      }
    },
    "points_overview": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "category",
          "label",
          "deduction_band"
        ],
        "properties": {
          "category": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string",
            "minLength": 1
          },
          "deduction_band": {
            "type": "string",
            "enum": [
              "Lavt trekk",
              "Middels trekk",
              "Høyt trekk",
              "Ikke scoretrekk"
            ]
          }
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "category",
          "severity",
          "title",
          "message",
          "deduction_band"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "minor",
              "major"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "deduction_band": {
            "type": "string",
            "enum": [
              "Lavt trekk",
              "Middels trekk",
              "Høyt trekk",
              "Ikke scoretrekk"
            ]
          },
          "recommended_fix_text": {
            "type": "string"
          },
          "evidence_snippets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gate_effect": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "blocks_96_gate": {
                "type": "boolean"
              },
              "caps_total_score_to": {
                "anyOf": [
                  {
                    "type": "integer",
                    "enum": [
                      95
                    ]
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          },
          "affects_96_gate": {
            "type": "boolean",
            "description": "Legacy-felt. Bruk gate_effect fremover."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "analysis_complete": {
            "const": true
          }
        },
        "required": [
          "analysis_complete"
        ]
      },
      "then": {
        "required": [
          "version",
          "analysis_complete",
          "report_id",
          "document_hash",
          "ordering",
          "gate",
          "score",
          "points_overview",
          "findings"
        ]
      },
      "else": {
        "required": [
          "version",
          "analysis_complete",
          "report_id",
          "document_hash",
          "ordering",
          "gate"
        ],
        "properties": {
          "score": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object"
              }
            ]
          },
          "points_overview": {
            "type": "array",
            "maxItems": 0,
            "description": "Kan utelates eller være tom ved INCOMPLETE."
          },
          "findings": {
            "type": "array",
            "maxItems": 0,
            "description": "Kan utelates eller være tom ved INCOMPLETE."
          }
        }
      }
    }
  ]
}