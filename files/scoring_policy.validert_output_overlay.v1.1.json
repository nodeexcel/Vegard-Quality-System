{
  "policy_id": "scoring_policy.validert_output_overlay",
  "version": "1.2.0",
  "language": "nb-NO",
  "description": "Overlay for bruker-output: skjuler numeriske trekk, bruker sjablong (lav/middels/høy), og bevarer full funnliste og konkret endringstekst.",
  "compatible_with": {
    "feedback_schema": ["v1.5"],
    "public_output_schema": ["1.6"],
    "rag_scoring_model": [">=1.6.3"]
  },

  "visibility": {
    "hide_numeric_deductions": true,
    "show_deduction_band": true,
    "show_full_internal_deduction_list": true,
    "hide_rule_id": true,
    "hide_source_module": true
  },

  "deduction_banding": {
    "enabled": true,
    "source_field": "deduction",
    "target_field": "deduction_band",
    "bands": [
      { "label": "Lavt trekk", "min_inclusive": 0.1, "max_inclusive": 3.0 },
      { "label": "Middels trekk", "min_inclusive": 3.01, "max_inclusive": 7.0 },
      { "label": "Høyt trekk", "min_inclusive": 7.01, "max_inclusive": 9999 }
    ],
    "when_missing_or_zero": {
      "set": null,
      "notes": "Hvis deduction er 0 eller mangler, settes deduction_band normalt til null."
    }
  },

  "gate_messaging": {
    "enabled": true,
    "if_blocked_96": {
      "set_gate_message": "Rapporten kan ikke oppnå over 95 % før gate-avvik er rettet.",
      "append_to_disclaimers": false
    }
  },

  "text_quality": {
    "enabled": true,
    "require_actionable_what_to_change": true,
    "require_non_contradictory_language": true,
    "notes": [
      "Overlay skal ikke fjerne hva som må endres. Bruker skal få samme konkrete tilbakemelding som admin."
    ]
  },

  "field_transforms": [
    {
      "path": "findings[].rule_id",
      "action": "remove_if",
      "condition": "visibility.hide_rule_id == true"
    },
    {
      "path": "findings[].deduction",
      "action": "remove_if",
      "condition": "visibility.hide_numeric_deductions == true"
    },
    {
      "path": "findings[].source_module",
      "action": "remove_if",
      "condition": "visibility.hide_source_module == true"
    },
    {
      "path": "points_overview[].deduction_total",
      "action": "remove_if",
      "condition": "visibility.hide_numeric_deductions == true"
    },
    {
      "path": "points_overview[].deduction_band",
      "action": "compute_from_findings",
      "condition": "visibility.show_deduction_band == true",
      "compute": {
        "mode": "max_band_by_related_findings",
        "relation": "points_overview[].finding_ids -> findings[].finding_id",
        "output_labels": ["Lavt trekk", "Middels trekk", "Høyt trekk"]
      }
    }
  ],

  "output_projection": {
    "public_output": {
      "include_fields": [
        "meta",
        "trygghetsscore",
        "score_band",
        "gate",
        "top_issues",
        "all_findings",
        "how_to_improve",
        "category_breakdown",
        "disclaimers"
      ],
      "top_issues_selection": {
        "max_items": 3,
        "priority_order": [
          "gate_effect.blocks_96_gate desc",
          "severity major>minor>info",
          "deduction_band Høyt>Middels>Lavt",
          "document_order"
        ]
      }
    }
  },

  "notes": [
    "Denne policyen forutsetter at findings inneholder gate_effect og severity (info/minor/major).",
    "Numeriske trekk skjules for bruker, men deduction_band beholdes.",
    "Full funnliste skal vises i første kjøring, ikke gradvis over flere runder."
  ]
}