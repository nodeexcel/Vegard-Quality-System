{
  "version": "v1.0",
  "module": "room_instances",
  "purpose": "Represent multiple occurrences (instances) of the same room type (e.g., Bathroom #1..N) so validation (TG + ARKAT) can run per instance and coverage can be proven.",
  "room_types": [
    {
      "room_type": "bathroom",
      "element_id": "BE-20",
      "multiplicity": "MULTI",
      "labels": ["bad", "bad/wc", "wc/bad", "dusjrom", "baderom", "wc/dusj"]
    },
    {
      "room_type": "laundry",
      "element_id": "BE-21",
      "multiplicity": "MULTI",
      "labels": ["vaskerom", "teknisk rom", "bod/vask", "grovkjøkken"]
    },
    {
      "room_type": "kitchen",
      "element_id": "BE-22",
      "multiplicity": "MULTI",
      "labels": ["kjøkken", "kjøkken/stue", "kjøkkenavdeling"]
    },
    {
      "room_type": "wc_non_wet",
      "element_id": "BE-23",
      "multiplicity": "MULTI",
      "labels": ["wc", "toalett", "gjestetoalett"]
    }
  ],
  "instance_object": {
    "instance_id": "string (unique, stable within report)",
    "room_type": "bathroom|laundry|kitchen|wc_non_wet|other",
    "element_id": "string",
    "label": "string",
    "ordinal": "integer (1..N per room_type)",
    "location": {
      "floor": "string|null",
      "zone": "string|null"
    },
    "source": {
      "header_text": "string|null",
      "page": "integer|null",
      "span": {
        "start_char": "integer",
        "end_char": "integer"
      }
    },
    "section_confidence": "number (0..1)"
  },
  "constraints": {
    "assignment_must_be_exclusive": true,
    "each_finding_chunk_assigned_to_one_instance": true,
    "instance_spans_must_not_overlap": true
  }
}