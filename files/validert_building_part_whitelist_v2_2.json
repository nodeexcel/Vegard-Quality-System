{
  "schema": "validert.building_part_whitelist",
  "version": "2.1.0",
  "updated_at": "2026-03-02",
  "notes": [
    "Purpose: stabilize 'punkt-for-punkt oversikt' across many report templates by mapping noisy headings to canonical building parts.",
    "This whitelist is used ONLY to decide which detected headings become segments shown in the UI and fed to ARK/ARKAT validation.",
    "It also labels building parts as (required by forskrift) vs (ikke lovpålagt)."
  ],
  "normalization": {
    "lowercase": true,
    "strip": true,
    "collapse_whitespace": true,
    "remove_soft_hyphen": true,
    "unicode_nfkc": true,
    "replace_chars": {
      "–": "-",
      "—": "-",
      "•": " ",
      " ": " "
    },
    "remove_prefixes_regex": [
      "^(pkt|punkt)\\s*",
      "^kap(ittel)?\\s*",
      "^del\\s*",
      "^sone\\s*"
    ],
    "remove_suffixes_regex": [
      "\\s*\\(.*?\\)\\s*$"
    ],
    "reject_if_regex": [
      "^\\d{1,3}(\\s*\\d{3})+$",
      "^ukjent$",
      "^etg[:.]?$",
      "^kostnadspekulasjon$",
      "^for\\s+ytterligere\\s+vurderinger\\.?$",
      "^vurderinger$",
      "^dokumentasjon$"
    ]
  },
  "classification": {
    "instance_extract": {
      "regex_order": [
        "^(?P<etasje>(underetasje|kjeller|sokkel|loft|1\\.?\\s*etg|2\\.?\\s*etg|3\\.?\\s*etg))\\s*[>:/-]\\s*(?P<rom>.+)$",
        "^(?P<rom>(bad|wc|toalett|vaskerom|dusj|kjøkken))\\s*(?P<etasje>(underetasje|kjeller|sokkel|loft|1\\.?\\s*etg|2\\.?\\s*etg|3\\.?\\s*etg))$",
        "^(?P<base>.+?)\\s*[:\\-]\\s*(?P<label>.+)$"
      ],
      "rom_synonyms": {
        "bad": [
          "bad",
          "baderom"
        ],
        "wc": [
          "wc",
          "toalett"
        ],
        "vaskerom": [
          "vaskerom",
          "laundry"
        ],
        "kjøkken": [
          "kjøkken"
        ],
        "dusj": [
          "dusj"
        ]
      }
    }
  },
  "building_parts": [
    {
      "id": "BP_LOVLIGHET",
      "display_name": "Lovlighet / tiltak (PBL-dokumentasjon, tegninger, ferdigattest mv.)",
      "required_by_forskrift": true,
      "ui_badge": null,
      "match": {
        "exact": [
          "lovlighet",
          "lovlighet/hms",
          "lovlighet / hms"
        ],
        "contains_any": [
          "ferdigattest",
          "midlertidig brukstillatelse",
          "tegninger",
          "kommunepakken",
          "pbl",
          "bruksendring",
          "tilbygg",
          "påbygg"
        ],
        "regex_any": [
          "\\blovlig(het| status)\\b"
        ]
      }
    },
    {
      "id": "BP_VATROM",
