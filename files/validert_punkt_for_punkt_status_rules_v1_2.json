{
  "version": "v1.2",
  "notes": "MANDATORY elements are always shown. OPTIONAL and NON_MANDATORY_ASSESSED elements are only shown if present in the report.",
  "status_logic": {
    "MANDATORY": {
      "show_always": true,
      "if_missing": "Ikke vurdert"
    },
    "NON_MANDATORY_ASSESSED": {
