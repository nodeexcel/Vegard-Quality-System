  "enforcement": {
    "tag_each_segment_with_legal_status": true,
    "ui_show_legal_badge": true,
    "ui_append_suffix_for_non_required": " (ikke lovpålagt)",
    "scoring_policy": {
      "do_not_penalize_missing_non_required_segments": true,
      "penalize_if_non_required_is_included_but_risky_claims_made": true,
      "non_required_risk_triggers": [
        "TG settes",
        "tilstandsgrad",
        "funksjonstestet",
        "kontrollert",
        "avdekket",
        "bekreftet",
        "feil",
        "mangel",
        "ikke forskriftsmessig",
        "ikke fagmessig"
      ],
      "remediation_text_non_required": "Bygningsdelen er ikke lovpålagt å vurdere. Hvis du likevel omtaler den, må du enten (a) beskrive undersøkelsesomfang og forbehold tydelig, eller (b) unngå TG og bastante konklusjoner uten dokumentasjon."
    }
  },

  "validation_rules": {
    "exact_match_required": true,
    "allow_alias_mapping": true,
    "reject_if_not_canonical_or_alias": true,
    "reject_if_hard_regex_match": true
  },

  "hierarchy_rules": {
    "build_tree_only_from_validated_segments": true,
    "children_must_map_to_valid_parent": true,
    "never_render_invalid_segment": true
  }
