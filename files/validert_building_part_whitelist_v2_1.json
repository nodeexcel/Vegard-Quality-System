  "version": "2.1",
  "description": "Strict canonical building-part whitelist with legal requirement tagging (lovpålagt vs ikke-lovpålagt). Exact match only + alias mapping. Includes hard reject regex to prevent stray headings/numbers from becoming segments.",
  "normalization": {
    "lowercase": true,
    "strip_whitespace": true,
    "remove_trailing_colon": true,
    "remove_trailing_comma": true,
    "collapse_multiple_spaces": true
  },
  "hard_reject_regex": [
    "^\\d+[\\s.,-]*$",
    "^[a-zæøå]{1,6}:$",
    "^for\\s+",
    "^med\\s+",
    "^inkl\\.?\\b",
    "^indikasjon(er)?\\b",
    "^kostnads",
    "^vurdering(er)?\\b",
    "^kommentar\\b",
    "^dokumentasjon\\b",
    "^oppsummering\\b",
    "^konklusjon\\b",
    "^m\\.m\\.$",
    "^mv\\.$",
    "^ikke\\b",
    "^ukjent\\b"
  ],

  "labels": {
    "LOVPAALAGT": "lovpålagt",
    "IKKE_LOVPAALAGT": "ikke lovpålagt",
    "UKLART": "uklart/avhenger av rapporttype"
